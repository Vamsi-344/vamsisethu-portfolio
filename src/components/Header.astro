---
import Container from "@components/Container.astro";
import { SITE } from "@consts";

const NAV = [
  { href: "/work", label: "Work" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Writing" },
  { href: "/certifications", label: "About" },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <Container>
    <div class="site-nav">
      <a href="/" aria-label={`${SITE.NAME} home`} class="site-wordmark">
        {SITE.NAME}
      </a>
      <nav class="site-nav-links" aria-label="Primary navigation">
        {NAV.map(item => {
          const active = path.startsWith(item.href);
          return (
            <a href={item.href} aria-current={active ? "page" : undefined}>
              {item.label}
            </a>
          );
        })}
      </nav>
      <a href="/Vamsi_Krishna_Sethu_Resume.pdf" class="site-nav-cta">Résumé</a>
    </div>
  </Container>
</header>
