---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between md:gap-4">
      <Link href="/" underline={false} aria-label={`${SITE.NAME} home`} class="w-fit">
        <div class="font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex flex-wrap gap-x-3 gap-y-1 text-sm md:gap-1" aria-label="Primary navigation">
        <Link href="/blog" class="shrink-0">
          blog
        </Link>
        <span class="hidden md:inline">
          {`/`}
        </span>
        <Link href="/spaces" class="shrink-0">
          spaces
        </Link>
        <span class="hidden md:inline">
          {`/`}
        </span>
        <Link href="/work" class="shrink-0">
          work
        </Link>
        <span class="hidden md:inline">
          {`/`}
        </span>
        <Link href="/projects" class="shrink-0">
          projects
        </Link>
        <span class="hidden md:inline">
          {`/`}
        </span>
        <Link href="/certifications" class="shrink-0">
          certs
        </Link>
        <span class="hidden md:inline">
          {`/`}
        </span>
        <Link href="/Vamsi_Krishna_Sethu_Resume.pdf" class="shrink-0">
          resume
        </Link>
      </nav>
    </div>
  </Container>
</header>
