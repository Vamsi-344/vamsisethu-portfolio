---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const date = entry.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const tags = ("tags" in entry.data ? entry.data.tags ?? [] : []).slice(0, 3);
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="nb-card-interactive nb-accent nb-accent-border group relative flex flex-nowrap items-center gap-4 border-l-[12px] py-3.5 pl-4 pr-14 no-underline"
>
  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <div class="flex flex-wrap items-center gap-2 font-mono text-[0.7rem] font-bold uppercase tracking-wider nb-muted">
      <time datetime={entry.data.date.toISOString()}>{date}</time>
      {tags.map(tag => (
        <span class="rounded border-2 border-nb-border bg-nb-zebra px-1.5 text-nb-ink dark:border-nb-border-dark dark:bg-transparent dark:text-nb-ink-dark">{tag}</span>
      ))}
    </div>
    <div class="font-black leading-snug text-nb-ink dark:text-nb-ink-dark sm:truncate">
      {entry.data.title}
    </div>
    <div class="truncate text-sm font-medium leading-6 nb-muted">
      {entry.data.description}
    </div>
  </div>
  <span
    class="nb-accent-bg absolute right-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-nb border-[3px] border-nb-border text-nb-ink transition-transform duration-150 group-hover:translate-x-1 group-hover:-rotate-6 dark:border-nb-border-dark"
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-[3]">
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </svg>
  </span>
</a>
