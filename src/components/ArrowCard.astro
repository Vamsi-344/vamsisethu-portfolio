---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const date = entry.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const tags = ("tags" in entry.data ? entry.data.tags ?? [] : []).slice(0, 3);
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="apple-preview group relative flex flex-nowrap items-center gap-4 py-5 pl-5 pr-14 no-underline"
>
  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <div class="card-meta flex flex-wrap items-center gap-2">
      <time datetime={entry.data.date.toISOString()}>{date}</time>
      {tags.map(tag => (
        <span class="apple-preview-tag">{tag}</span>
      ))}
    </div>
    <div class="card-title leading-snug sm:truncate">
      {entry.data.title}
    </div>
    <div class="card-description truncate text-sm leading-6">
      {entry.data.description}
    </div>
  </div>
  <span
    class="apple-preview-arrow absolute right-5 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center"
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-[3]">
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </svg>
  </span>
</a>
