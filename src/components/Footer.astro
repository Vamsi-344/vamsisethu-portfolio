---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
import BackToTop from "@components/BackToTop.astro";
---

<footer class="site-footer animate">
  <Container>
    <div class="site-footer-top">
      <div>
        <p class="site-footer-name">{SITE.NAME}</p>
        <p class="site-footer-copy">Software engineering, infrastructure, and technical notes.</p>
      </div>
      <a class="site-footer-contact" href={`mailto:${SITE.EMAIL}`}>Get in touch <span aria-hidden="true">↗</span></a>
    </div>
    <div class="site-footer-bottom">
      <div class="flex items-center gap-4"><span>© 2026 {SITE.NAME}</span><a class="text-link" href="/rss.xml">RSS</a></div>
      <div class="flex items-center gap-5"><BackToTop /><div class="theme-switch" aria-label="Color theme"><button id="light-theme-button" aria-label="Use light theme">Light</button><button id="dark-theme-button" aria-label="Use dark theme">Dark</button><button id="system-theme-button" aria-label="Use system theme">Auto</button></div></div>
    </div>
  </Container>
</footer>
