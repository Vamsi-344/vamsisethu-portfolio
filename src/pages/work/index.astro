---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { dateRange } from "@lib/utils";
import { WORK } from "@consts";
const collection = (await getCollection("work")).sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf());
const work = await Promise.all(collection.map(async item => ({ ...item, Content: (await item.render()).Content })));
---
<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container><div class="space-y-12">
    <section class="page-intro animate"><p class="eyebrow">Experience</p><h1 class="mt-3">Work</h1><p class="mt-5">Where I have built and operated platforms, newest first.</p></section>
    <ul class="space-y-4">
      {work.map(entry => <li class="animate credential-card"><div class="flex flex-wrap items-baseline justify-between gap-2"><div><h2 class="text-xl font-semibold tracking-tight">{entry.data.company}</h2><p class="meta-text mt-1">{entry.data.role}</p></div><time class="meta-text">{dateRange(entry.data.dateStart, entry.data.dateEnd)}</time></div><article class="mt-4"><entry.Content /></article></li>)}
    </ul>
  </div></Container>
</PageLayout>
