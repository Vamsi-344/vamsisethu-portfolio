---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/projects">
        Back to projects
      </BackToPrev>
    </div>
    <div class="animate nb-on-color relative my-8 rounded-nb border-4 border-nb-border bg-nb-orange p-6 shadow-nb-xl sm:p-8">
      <div class="flex flex-wrap gap-2 font-mono text-xs font-black uppercase">
        <span class="rounded border-2 border-nb-border bg-white px-2 py-1">📅 <FormattedDate date={project.data.date} /></span>
        <span class="rounded border-2 border-nb-border bg-white px-2 py-1">⏱ {readingTime(project.body)}</span>
      </div>
      <h1 class="mt-4 text-balance text-3xl font-black leading-tight tracking-tight sm:text-4xl">
        {project.data.title}
      </h1>
      <p class="mt-3 text-lg font-semibold">{project.data.description}</p>
      {(project.data.demoURL || project.data.repoURL) && (
        <nav class="mt-5 flex flex-wrap gap-3">
          {project.data.demoURL && (
            <a href={project.data.demoURL} target="_blank" rel="noopener noreferrer" class="nb-btn-white text-sm">Live demo ↗</a>
          )}
          {project.data.repoURL && (
            <a href={project.data.repoURL} target="_blank" rel="noopener noreferrer" class="nb-btn bg-nb-ink text-sm !text-nb-yellow">Repository ↗</a>
          )}
        </nav>
      )}
    </div>
    <div class="animate nb-panel px-5 py-7 sm:px-10 sm:py-10">
      <article>
        <Content />
      </article>
    </div>
  </Container>
</PageLayout>