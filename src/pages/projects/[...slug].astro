---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="mx-auto max-w-[48rem]">
      <div class="animate">
        <BackToPrev href="/projects">
          Back to projects
        </BackToPrev>
      </div>
      <header class="project-intro animate my-8">
        <p class="docs-kicker"><FormattedDate date={project.data.date} /> · {readingTime(project.body)}</p>
        <h1>{project.data.title}</h1>
        <p>{project.data.description}</p>
        {(project.data.demoURL || project.data.repoURL) && (
          <nav class="mt-5 flex flex-wrap gap-4">
            {project.data.demoURL && <a href={project.data.demoURL} target="_blank" rel="noopener noreferrer" class="text-link text-sm">Live demo ↗</a>}
            {project.data.repoURL && <a href={project.data.repoURL} target="_blank" rel="noopener noreferrer" class="text-link text-sm">Repository ↗</a>}
          </nav>
        )}
      </header>
      <div class="project-content animate">
        <article>
          <Content />
        </article>
      </div>
    </div>
  </Container>
</PageLayout>