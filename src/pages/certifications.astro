---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { CERTIFICATIONS, CERTS } from "@consts";

const allCreds = [CERTS.KUBESTRONAUT, ...CERTS.ITEMS];
const certsSchema = {
  "@context": "https://schema.org", "@type": "ItemList", name: "Certifications",
  itemListElement: allCreds.map((c, i) => ({ "@type": "ListItem", position: i + 1, item: { "@type": "EducationalOccupationalCredential", name: c.NAME, credentialCategory: "certification", url: c.HREF, recognizedBy: { "@type": "Organization", name: "Cloud Native Computing Foundation", url: "https://www.cncf.io/" } } })),
};
---
<PageLayout title={CERTIFICATIONS.TITLE} description={CERTIFICATIONS.DESCRIPTION} structuredData={certsSchema}>
  <Container><div class="space-y-14">
    <section class="page-intro animate">
      <p class="eyebrow">Professional development</p>
      <h1 class="mt-3">Certifications</h1>
      <p class="mt-5 max-w-2xl">I am a CNCF Kubestronaut, awarded after earning all five active CNCF Kubernetes certifications. Each credential links to its public verification.</p>
    </section>
    <section class="animate">
      <a href={CERTS.KUBESTRONAUT.HREF} target="_blank" rel="noopener noreferrer" class="credential-card block no-underline">
        <p class="eyebrow">Featured credential</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-nb-ink dark:text-nb-ink-dark">{CERTS.KUBESTRONAUT.NAME}</h2>
        <p class="meta-text mt-1">{CERTS.KUBESTRONAUT.ISSUER}</p>
        <p class="mt-4 max-w-2xl text-nb-ink/80 dark:text-nb-ink-dark/80">{CERTS.KUBESTRONAUT.DESCRIPTION}</p>
        <span class="text-link mt-5 inline-block text-sm">Verify on Credly <span aria-hidden="true">→</span></span>
      </a>
    </section>
    <section class="animate space-y-6">
      <h2 class="text-3xl font-semibold tracking-tight">Kubernetes certifications</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {CERTS.ITEMS.map(cert => <li><a href={cert.HREF} target="_blank" rel="noopener noreferrer" class="credential-card flex h-full flex-col no-underline"><h3 class="font-semibold text-nb-ink dark:text-nb-ink-dark">{cert.NAME}</h3><p class="meta-text mt-2">{cert.ISSUER}</p><span class="text-link mt-5 text-sm">Verify credential →</span></a></li>)}
      </ul>
    </section>
  </div></Container>
</PageLayout>
