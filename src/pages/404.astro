---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<PageLayout title="404" description="Page not found">
  <Container>
    <div class="space-y-6">
      <h4 class="animate font-semibold text-black dark:text-white">
        404 — Page not found
      </h4>
      <p class="animate">
        The page you are looking for doesn't exist or may have moved.
      </p>
      <ul class="animate flex flex-wrap gap-2">
        <li class="flex gap-x-2 text-nowrap">
          <Link href="/" aria-label="Go to home">Home</Link>
          {"/"}
        </li>
        <li class="flex gap-x-2 text-nowrap">
          <Link href="/blog" aria-label="Go to blog">Blog</Link>
          {"/"}
        </li>
        <li class="flex gap-x-2 text-nowrap">
          <Link href="/projects" aria-label="Go to projects">Projects</Link>
        </li>
      </ul>
    </div>
  </Container>
</PageLayout>
