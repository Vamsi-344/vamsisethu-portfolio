---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
---

<PageLayout title="404" description="Page not found">
  <Container>
    <div class="animate nb-on-color rounded-nb border-4 border-nb-border bg-nb-pink p-8 text-center shadow-nb-xl">
      <div class="text-8xl font-black tracking-tighter">404</div>
      <p class="mt-2 text-xl font-black uppercase">Page not found</p>
      <p class="mt-2 font-semibold">The page you are looking for doesn't exist or may have moved.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="nb-btn" aria-label="Go to home">Home</a>
        <a href="/blog" class="nb-btn-blue" aria-label="Go to blog">Blog</a>
        <a href="/projects" class="nb-btn-white" aria-label="Go to projects">Projects</a>
      </div>
    </div>
  </Container>
</PageLayout>
