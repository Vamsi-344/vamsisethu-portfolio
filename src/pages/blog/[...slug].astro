---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import GiscusComments from "@components/GiscusComments.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import { SITE } from "@consts";
import { getSpaces } from "@lib/spaces";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      newerPost: posts[index - 1],
      olderPost: posts[index + 1],
    },
  }));
}
type Props = {
  post: CollectionEntry<"blog">;
  newerPost?: CollectionEntry<"blog">;
  olderPost?: CollectionEntry<"blog">;
};

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await post.render();
const spaces = getSpaces(post.data.spaces);
const toc = headings.filter(heading => heading.depth >= 2 && heading.depth <= 3);

const ogImage = `/og/${post.slug}.png`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: new URL(ogImage, Astro.site).toString(),
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  keywords: post.data.tags?.join(", "),
  author: {
    "@type": "Person",
    name: SITE.NAME,
    url: Astro.site?.toString(),
  },
  publisher: {
    "@type": "Person",
    name: SITE.NAME,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).toString(),
  },
};

const tags = post.data.tags ?? [];
const sectionCount = headings.filter(heading => heading.depth === 2).length;
const postURL = new URL(Astro.url.pathname, Astro.site).toString();
const shareX = `https://x.com/intent/post?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postURL)}`;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postURL)}`;
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  type="article"
  publishedTime={post.data.date.toISOString()}
  structuredData={articleSchema}
>
  <div id="read-progress" class="reading-progress" aria-hidden="true"></div>

  <div class="mx-auto max-w-screen-xl px-5">
    <div class="animate mx-auto max-w-[48rem] lg:mx-0 lg:ml-[calc(240px+2.5rem)]">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>

    <div class="mt-8 lg:grid lg:grid-cols-[240px_minmax(0,48rem)] lg:gap-10">
      <!-- Desktop TOC -->
      <aside class="hidden lg:block">
        {toc.length >= 3 && (
          <nav class="docs-toc animate sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto" aria-label="Table of contents">
            <div class="docs-toc-label"><span>Contents</span><span id="toc-percent">0%</span></div>
            <ol>{toc.map((heading) => (
              <li class={heading.depth === 3 ? "docs-toc-subitem" : ""}><a href={`#${heading.slug}`} data-toc-link={heading.slug} class="toc-link">{heading.text}</a></li>
            ))}</ol>
          </nav>
        )}
      </aside>

      <div class="min-w-0">
        <header class="post-intro animate mb-10">
          <p class="docs-kicker">Article {tags.length > 0 && <>· {tags.map((tag, index) => <><a class="docs-tag-link" href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a>{index < tags.length - 1 && " / "}</>)}</>}</p>
          <h1 id="post-title">{post.data.title}</h1>
          <p class="post-summary">{post.data.description}</p>
          <div class="docs-meta"><span><FormattedDate date={post.data.date} /></span><span>{readingTime(post.body)}</span>{sectionCount > 0 && <span>{sectionCount} sections</span>}</div>
          {spaces.length > 0 && <p class="docs-filed-under">Related topics: {spaces.map((space, index) => <><a href={`/spaces/${space.slug}`}>{space.name}</a>{index < spaces.length - 1 && ", "}</>)}</p>}
        </header>

        <!-- Mobile TOC -->
        {toc.length >= 3 && (
          <details class="docs-toc-mobile animate mb-8 lg:hidden">
            <summary>Contents <span>{toc.length}</span></summary>
            <ol>{toc.filter(h => h.depth === 2).map((heading) => (<li><a href={`#${heading.slug}`}>{heading.text}</a></li>))}</ol>
          </details>
        )}

        <!-- Article -->
        <div class="animate post-content">
          <article id="post-body" data-pagefind-body>
            <Content />
          </article>

          <div class="docs-share">
            <span class="meta-text">Share this post</span>
            <a href={shareX} target="_blank" rel="noopener noreferrer" class="text-link text-sm">Post on X</a>
            <a href={shareLinkedIn} target="_blank" rel="noopener noreferrer" class="text-link text-sm">LinkedIn</a>
            <button type="button" data-copy-link class="text-link border-0 bg-transparent text-sm">Copy link</button>
          </div>
        </div>

        {(olderPost || newerPost) && (
          <nav class="animate mt-12 grid gap-5 sm:grid-cols-2" aria-label="Post navigation">
            {olderPost ? (
              <a href={`/blog/${olderPost.slug}`} class="docs-post-nav">
                <div>Previous article</div>
                <div>{olderPost.data.title}</div>
              </a>
            ) : <div class="hidden sm:block" />}
            {newerPost ? (
              <a href={`/blog/${newerPost.slug}`} class="docs-post-nav sm:text-right">
                <div>Next article</div>
                <div>{newerPost.data.title}</div>
              </a>
            ) : <div class="hidden sm:block" />}
          </nav>
        )}

        <GiscusComments />
      </div>
    </div>
  </div>

  <div id="nb-toast" role="status" aria-live="polite" class="docs-toast pointer-events-none fixed bottom-6 left-1/2 z-[70] -translate-x-1/2 translate-y-24"></div>
</PageLayout>

<script>
  type Win = Window & { cleanupPost?: () => void };

  const toast = (message: string) => {
    const el = document.getElementById("nb-toast");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("translate-y-24");
    window.clearTimeout(Number(el.dataset.timer));
    el.dataset.timer = String(window.setTimeout(() => el.classList.add("translate-y-24"), 1600));
  };

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  };

  const enhanceContent = (body: HTMLElement) => {
    if (body.dataset.enhanced === "true") return;
    body.dataset.enhanced = "true";

    // Keep wide tables readable on mobile and keyboard-scrollable.
    body.querySelectorAll("table").forEach((table, index) => {
      if (table.parentElement?.classList.contains("docs-table-wrap")) return;
      const wrap = document.createElement("div");
      wrap.className = "docs-table-wrap";
      wrap.tabIndex = 0;
      wrap.setAttribute("role", "region");
      wrap.setAttribute("aria-label", table.caption?.textContent?.trim() || `Table ${index + 1} — scroll horizontally for more columns`);
      table.querySelectorAll("thead th").forEach((header) => {
        if (!header.hasAttribute("scope")) header.setAttribute("scope", "col");
      });
      table.replaceWith(wrap);
      wrap.appendChild(table);
    });

    // Code blocks: language label + copy button.
    body.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
      const wrap = document.createElement("div");
      wrap.className = "docs-code";
      const bar = document.createElement("div");
      bar.className = "docs-code-bar";
      const lang = document.createElement("span");
      lang.className = "docs-code-lang";
      lang.textContent = pre.dataset.language && pre.dataset.language !== "plaintext" ? pre.dataset.language : "code";
      const button = document.createElement("button");
      button.type = "button";
      button.className = "docs-code-copy";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy code to clipboard");
      button.addEventListener("click", async () => {
        const ok = await copy(pre.innerText);
        button.textContent = ok ? "Copied!" : "Failed";
        button.classList.toggle("copied", ok);
        window.setTimeout(() => {
          button.textContent = "Copy";
          button.classList.remove("copied");
        }, 1400);
      });
      bar.append(lang, button);
      pre.replaceWith(wrap);
      wrap.append(bar, pre);
    });

    // Heading anchors: click to copy a deep link.
    body.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]").forEach((heading) => {
      const anchor = document.createElement("a");
      anchor.href = `#${heading.id}`;
      anchor.className = "docs-anchor";
      anchor.textContent = "#";
      anchor.setAttribute("aria-label", `Copy link to section: ${heading.textContent ?? ""}`);
      anchor.addEventListener("click", async (event) => {
        event.preventDefault();
        const url = `${location.origin}${location.pathname}#${heading.id}`;
        history.replaceState(null, "", `#${heading.id}`);
        heading.scrollIntoView({ behavior: "smooth", block: "start" });
        if (await copy(url)) toast("Section link copied");
      });
      heading.appendChild(anchor);
    });
  };

  const initPost = () => {
    const win = window as Win;
    win.cleanupPost?.();

    const body = document.getElementById("post-body");
    if (!body) return;
    enhanceContent(body);

    const progress = document.getElementById("read-progress");
    const percent = document.getElementById("toc-percent");
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const tocHeadings = tocLinks
      .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((heading): heading is HTMLElement => Boolean(heading));

    const onScroll = () => {
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const ratio = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - rect.top) / Math.max(total, 1)));
      if (progress) progress.style.transform = `scaleX(${ratio})`;
      if (percent) percent.textContent = `${Math.round(ratio * 100)}%`;

      if (tocHeadings.length === 0) return;
      const active = [...tocHeadings].reverse().find((heading) => heading.getBoundingClientRect().top <= 160) ?? tocHeadings[0];
      tocLinks.forEach((link) => link.classList.toggle("is-active", link.dataset.tocLink === active.id));
    };

    const copyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-copy-link]"));
    const onCopyLink = async () => {
      if (await copy(location.href.split("#")[0])) toast("Link copied");
    };
    copyButtons.forEach((button) => button.addEventListener("click", onCopyLink));

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    win.cleanupPost = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      copyButtons.forEach((button) => button.removeEventListener("click", onCopyLink));
    };
  };

  document.addEventListener("astro:page-load", initPost);
  if (!document.querySelector("meta[name=astro-view-transitions-enabled]")) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPost, { once: true });
    } else {
      initPost();
    }
  }
</script>
