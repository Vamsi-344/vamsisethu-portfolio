---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import GiscusComments from "@components/GiscusComments.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import { SITE } from "@consts";
import { getSpaces } from "@lib/spaces";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      newerPost: posts[index - 1],
      olderPost: posts[index + 1],
    },
  }));
}
type Props = {
  post: CollectionEntry<"blog">;
  newerPost?: CollectionEntry<"blog">;
  olderPost?: CollectionEntry<"blog">;
};

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await post.render();
const spaces = getSpaces(post.data.spaces);
const toc = headings.filter(heading => heading.depth >= 2 && heading.depth <= 3);

const ogImage = `/og/${post.slug}.png`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: new URL(ogImage, Astro.site).toString(),
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  keywords: post.data.tags?.join(", "),
  author: {
    "@type": "Person",
    name: SITE.NAME,
    url: Astro.site?.toString(),
  },
  publisher: {
    "@type": "Person",
    name: SITE.NAME,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).toString(),
  },
};

const tags = post.data.tags ?? [];
const tagColors = ["bg-nb-pink", "bg-nb-blue", "bg-nb-green", "bg-nb-orange", "bg-nb-purple", "bg-white"];
const sectionCount = headings.filter(heading => heading.depth === 2).length;
const postURL = new URL(Astro.url.pathname, Astro.site).toString();
const shareX = `https://x.com/intent/post?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postURL)}`;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postURL)}`;
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImage}
  type="article"
  publishedTime={post.data.date.toISOString()}
  structuredData={articleSchema}
>
  <div id="read-progress" class="fixed left-0 top-0 z-[60] h-2 w-full origin-left scale-x-0 border-b-2 border-nb-ink bg-nb-pink" aria-hidden="true"></div>

  <div class="mx-auto max-w-screen-xl px-5">
    <div class="animate mx-auto max-w-[52rem] lg:mx-0 lg:ml-[calc(240px+2.5rem)]">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>

    <div class="mt-8 lg:grid lg:grid-cols-[240px_minmax(0,52rem)] lg:gap-10">
      <!-- Desktop TOC -->
      <aside class="hidden lg:block">
        {toc.length >= 3 && (
          <nav class="animate nb-card sticky top-28 max-h-[calc(100vh-8rem)] overflow-hidden" aria-label="Table of contents">
            <div class="flex items-center justify-between border-b-[3px] border-nb-border bg-nb-ink px-3 py-2 text-xs font-black uppercase tracking-wider text-nb-yellow dark:border-nb-border-dark">
              <span>On this page</span>
              <span id="toc-percent" class="font-mono">0%</span>
            </div>
            <ol class="max-h-[calc(100vh-14rem)] space-y-1 overflow-y-auto p-2 text-sm">
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? "pl-4 text-xs" : ""}>
                  <a href={`#${heading.slug}`} data-toc-link={heading.slug} class="toc-link block rounded border-2 border-transparent px-2 py-1 font-semibold leading-snug text-nb-ink/75 no-underline hover:border-nb-border hover:bg-nb-zebra hover:text-nb-ink dark:text-nb-ink-dark/75 dark:hover:border-nb-border-dark dark:hover:bg-white/5 dark:hover:text-nb-ink-dark">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <div class="min-w-0">
        <!-- Hero -->
        <div class="animate nb-on-color relative mb-10 rounded-nb border-4 border-nb-border bg-nb-yellow p-6 shadow-nb-xl sm:p-8">
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag, i) => (
                <span class={`nb-tag ${tagColors[i % tagColors.length]}`}>{tag}</span>
              ))}
            </div>
          )}
          <h1 id="post-title" class="mt-5 text-balance text-3xl font-black leading-[1.08] tracking-tight sm:text-[2.6rem]">
            {post.data.title}
          </h1>
          <p class="mt-4 text-lg font-semibold leading-7">
            {post.data.description}
          </p>
          <div class="mt-6 flex flex-wrap gap-2 font-mono text-xs font-black uppercase">
            <span class="rounded border-2 border-nb-border bg-white px-2 py-1">📅 <FormattedDate date={post.data.date} /></span>
            <span class="rounded border-2 border-nb-border bg-white px-2 py-1">⏱ {readingTime(post.body)}</span>
            {sectionCount > 0 && <span class="rounded border-2 border-nb-border bg-white px-2 py-1">§ {sectionCount} sections</span>}
            <span class="rounded border-2 border-nb-border bg-white px-2 py-1">✍ {SITE.NAME}</span>
          </div>
          {spaces.length > 0 && (
            <ul class="mt-4 flex flex-wrap items-center gap-2">
              <li class="text-xs font-black uppercase tracking-wider">Spaces:</li>
              {spaces.map((space) => (
                <li>
                  <a href={`/spaces/${space.slug}`} title={space.description} class="nb-press inline-flex items-center gap-1.5 rounded-nb border-2 border-nb-border bg-nb-ink px-2 py-0.5 text-xs font-bold !text-nb-yellow no-underline shadow-nb-xs">
                    # {space.name}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        <!-- Mobile TOC -->
        {toc.length >= 3 && (
          <details class="animate nb-card group mb-8 lg:hidden">
            <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 font-black uppercase tracking-tight [&::-webkit-details-marker]:hidden">
              <span class="inline-grid size-7 place-items-center rounded border-[3px] border-nb-border bg-nb-yellow text-nb-ink group-open:hidden">+</span>
              <span class="hidden size-7 place-items-center rounded border-[3px] border-nb-border bg-nb-pink text-nb-ink group-open:inline-grid">–</span>
              On this page
              <span class="ml-auto font-mono text-xs nb-muted">{toc.length} links</span>
            </summary>
            <ol class="flex flex-wrap gap-2 border-t-[3px] border-nb-border p-4 dark:border-nb-border-dark">
              {toc.filter(h => h.depth === 2).map((heading, i) => (
                <li>
                  <a href={`#${heading.slug}`} class="nb-press inline-block rounded-nb border-2 border-nb-border bg-white px-2 py-1 text-xs font-bold text-nb-ink no-underline shadow-nb-xs hover:bg-nb-blue">
                    <span class="font-mono">{String(i + 1).padStart(2, "0")}</span> {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}

        <!-- Article -->
        <div class="animate nb-panel px-5 py-7 sm:px-10 sm:py-10">
          <article id="post-body" data-pagefind-body>
            <Content />
          </article>

          <div class="mt-12 flex flex-wrap items-center gap-3 border-t-[3px] border-dashed border-nb-border pt-6 dark:border-nb-border-dark">
            <span class="text-sm font-black uppercase tracking-wider">Enjoyed this? Share it →</span>
            <a href={shareX} target="_blank" rel="noopener noreferrer" class="nb-chip nb-press bg-nb-blue text-xs uppercase">Post on X</a>
            <a href={shareLinkedIn} target="_blank" rel="noopener noreferrer" class="nb-chip nb-press bg-nb-green text-xs uppercase">LinkedIn</a>
            <button type="button" data-copy-link class="nb-chip nb-press bg-nb-yellow text-xs uppercase">Copy link</button>
          </div>
        </div>

        {(olderPost || newerPost) && (
          <nav class="animate mt-12 grid gap-5 sm:grid-cols-2" aria-label="Post navigation">
            {olderPost ? (
              <a href={`/blog/${olderPost.slug}`} class="nb-card-interactive nb-on-color group bg-nb-blue p-5 no-underline">
                <div class="mb-2 font-mono text-xs font-black uppercase tracking-wider">← Previous</div>
                <div class="line-clamp-2 font-black leading-snug">{olderPost.data.title}</div>
              </a>
            ) : <div class="hidden sm:block" />}
            {newerPost ? (
              <a href={`/blog/${newerPost.slug}`} class="nb-card-interactive nb-on-color group bg-nb-green p-5 no-underline sm:text-right">
                <div class="mb-2 font-mono text-xs font-black uppercase tracking-wider">Next →</div>
                <div class="line-clamp-2 font-black leading-snug">{newerPost.data.title}</div>
              </a>
            ) : <div class="hidden sm:block" />}
          </nav>
        )}

        <GiscusComments />
      </div>
    </div>
  </div>

  <div id="nb-toast" role="status" aria-live="polite" class="pointer-events-none fixed bottom-6 left-1/2 z-[70] -translate-x-1/2 translate-y-24 rounded-nb border-[3px] border-nb-border bg-nb-green px-4 py-2 text-sm font-black uppercase text-nb-ink shadow-nb-sm transition-transform duration-200"></div>
</PageLayout>

<script>
  type Win = Window & { cleanupPost?: () => void };

  const toast = (message: string) => {
    const el = document.getElementById("nb-toast");
    if (!el) return;
    el.textContent = message;
    el.classList.remove("translate-y-24");
    window.clearTimeout(Number(el.dataset.timer));
    el.dataset.timer = String(window.setTimeout(() => el.classList.add("translate-y-24"), 1600));
  };

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  };

  const enhanceContent = (body: HTMLElement) => {
    if (body.dataset.enhanced === "true") return;
    body.dataset.enhanced = "true";

    // Tables: scroll wrapper so the hard shadow is not clipped on mobile.
    body.querySelectorAll("table").forEach((table) => {
      if (table.parentElement?.classList.contains("nb-table-wrap")) return;
      const wrap = document.createElement("div");
      wrap.className = "nb-table-wrap";
      table.replaceWith(wrap);
      wrap.appendChild(table);
    });

    // Code blocks: language label + copy button.
    body.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
      const wrap = document.createElement("div");
      wrap.className = "nb-code";
      const bar = document.createElement("div");
      bar.className = "nb-code-bar";
      const lang = document.createElement("span");
      lang.className = "nb-code-lang";
      lang.textContent = pre.dataset.language && pre.dataset.language !== "plaintext" ? pre.dataset.language : "code";
      const button = document.createElement("button");
      button.type = "button";
      button.className = "nb-code-copy";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy code to clipboard");
      button.addEventListener("click", async () => {
        const ok = await copy(pre.innerText);
        button.textContent = ok ? "Copied!" : "Failed";
        button.classList.toggle("copied", ok);
        window.setTimeout(() => {
          button.textContent = "Copy";
          button.classList.remove("copied");
        }, 1400);
      });
      bar.append(lang, button);
      pre.replaceWith(wrap);
      wrap.append(bar, pre);
    });

    // Heading anchors: click to copy a deep link.
    body.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]").forEach((heading) => {
      const anchor = document.createElement("a");
      anchor.href = `#${heading.id}`;
      anchor.className = "nb-anchor";
      anchor.textContent = "#";
      anchor.setAttribute("aria-label", `Copy link to section: ${heading.textContent ?? ""}`);
      anchor.addEventListener("click", async (event) => {
        event.preventDefault();
        const url = `${location.origin}${location.pathname}#${heading.id}`;
        history.replaceState(null, "", `#${heading.id}`);
        heading.scrollIntoView({ behavior: "smooth", block: "start" });
        if (await copy(url)) toast("Section link copied");
      });
      heading.appendChild(anchor);
    });
  };

  const initPost = () => {
    const win = window as Win;
    win.cleanupPost?.();

    const body = document.getElementById("post-body");
    if (!body) return;
    enhanceContent(body);

    const progress = document.getElementById("read-progress");
    const percent = document.getElementById("toc-percent");
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const tocHeadings = tocLinks
      .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((heading): heading is HTMLElement => Boolean(heading));

    const onScroll = () => {
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const ratio = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - rect.top) / Math.max(total, 1)));
      if (progress) progress.style.transform = `scaleX(${ratio})`;
      if (percent) percent.textContent = `${Math.round(ratio * 100)}%`;

      if (tocHeadings.length === 0) return;
      const active = [...tocHeadings].reverse().find((heading) => heading.getBoundingClientRect().top <= 160) ?? tocHeadings[0];
      tocLinks.forEach((link) => link.classList.toggle("is-active", link.dataset.tocLink === active.id));
    };

    const copyButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-copy-link]"));
    const onCopyLink = async () => {
      if (await copy(location.href.split("#")[0])) toast("Link copied");
    };
    copyButtons.forEach((button) => button.addEventListener("click", onCopyLink));

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    win.cleanupPost = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      copyButtons.forEach((button) => button.removeEventListener("click", onCopyLink));
    };
  };

  document.addEventListener("astro:page-load", initPost);
</script>
