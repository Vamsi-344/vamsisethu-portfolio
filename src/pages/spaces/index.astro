---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { SPACES } from "@lib/spaces";
const posts = (await getCollection("blog")).filter(post => !post.data.draft);
const projects = (await getCollection("projects")).filter(project => !project.data.draft);
const spaces = SPACES.map(space => ({ ...space, postCount: posts.filter(post => post.data.spaces?.includes(space.slug)).length, projectCount: projects.filter(project => project.data.spaces?.includes(space.slug)).length }));
---
<PageLayout title="Spaces" description="Browse Vamsi Krishna Sethu's articles and projects by technical domain: Kubernetes, GitOps, AWS, observability, security, and homelab infrastructure.">
  <Container><div class="space-y-12">
    <section class="page-intro animate"><p class="eyebrow">Browse by domain</p><h1 class="mt-3">Spaces</h1><p class="mt-5">A map of the technical areas I write and build around, from Kubernetes and GitOps to security, observability, cloud, and homelab infrastructure.</p></section>
    <section class="animate"><ul class="grid gap-4 sm:grid-cols-2">{spaces.map(space => <li><a href={`/spaces/${space.slug}`} class="credential-card block h-full no-underline"><div class="flex items-start gap-4"><span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-black/[.05] dark:bg-white/[.10]" aria-hidden="true"><img src={space.logo} alt="" class="size-6 object-contain" loading="lazy" decoding="async" /></span><div><h2 class="text-lg font-semibold tracking-tight text-nb-ink dark:text-nb-ink-dark">{space.name}</h2><p class="meta-text mt-2 leading-6">{space.description}</p><p class="meta-text mt-4">{space.postCount} posts · {space.projectCount} projects</p></div></div></a></li>)}</ul></section>
    <a href="/" class="text-link animate inline-block text-sm">← Back home</a>
  </div></Container>
</PageLayout>
