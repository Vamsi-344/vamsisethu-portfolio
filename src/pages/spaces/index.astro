---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { SPACES } from "@lib/spaces";

const posts = (await getCollection("blog")).filter(post => !post.data.draft);
const projects = (await getCollection("projects")).filter(project => !project.data.draft);

const spaces = SPACES.map(space => ({
  ...space,
  postCount: posts.filter(post => post.data.spaces?.includes(space.slug)).length,
  projectCount: projects.filter(project => project.data.spaces?.includes(space.slug)).length,
}));
---

<PageLayout title="Spaces" description="Browse Vamsi Krishna Sethu's articles and projects by technical domain: Kubernetes, GitOps, AWS, observability, security, and homelab infrastructure.">
  <Container>
    <div class="space-y-10">
      <section class="animate nb-on-color rounded-nb border-4 border-nb-border bg-nb-purple p-6 shadow-nb-xl sm:p-8">
        <span class="nb-tag">Articles &amp; projects by domain</span>
        <h1 class="mt-3 text-5xl font-black uppercase tracking-tight sm:text-6xl">Spaces</h1>
        <p class="mt-3 max-w-2xl text-lg font-semibold leading-7">
          A map of the technical areas I write and build around — from Kubernetes and GitOps to security, observability, cloud, and homelab infrastructure.
        </p>
      </section>

      <section class="animate">
        <ul class="nb-cycle grid gap-5 sm:grid-cols-2">
          {spaces.map(space => (
            <li>
              <a href={`/spaces/${space.slug}`} class="nb-card-interactive group block h-full p-5 no-underline">
                <div class="flex items-start gap-4">
                  <span class="nb-accent nb-accent-bg flex size-12 shrink-0 items-center justify-center rounded-nb border-[3px] border-nb-border transition-transform group-hover:-rotate-6" aria-hidden="true">
                    <img src={space.logo} alt="" class="size-6 object-contain" loading="lazy" decoding="async" />
                  </span>
                  <div>
                    <h2 class="text-lg font-black uppercase tracking-tight text-nb-ink dark:text-nb-ink-dark">{space.name}</h2>
                    <p class="mt-2 text-sm font-medium leading-6 nb-muted">{space.description}</p>
                    <p class="mt-4 flex flex-wrap gap-2 font-mono text-xs font-black uppercase">
                      <span class="rounded border-2 border-nb-border bg-nb-yellow px-1.5 text-nb-ink">{space.postCount} post{space.postCount === 1 ? "" : "s"}</span>
                      <span class="rounded border-2 border-nb-border bg-nb-blue px-1.5 text-nb-ink">{space.projectCount} project{space.projectCount === 1 ? "" : "s"}</span>
                    </p>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="animate">
        <a href="/" class="nb-chip nb-press text-xs uppercase hover:bg-nb-yellow">← Back home</a>
      </div>
    </div>
  </Container>
</PageLayout>
