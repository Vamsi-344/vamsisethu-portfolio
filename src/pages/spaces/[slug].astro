---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { SPACES, getSpace } from "@lib/spaces";

export function getStaticPaths() {
  return SPACES.map(space => ({
    params: { slug: space.slug },
    props: { space },
  }));
}

const { space } = Astro.props;

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft && post.data.spaces?.includes(space.slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft && project.data.spaces?.includes(space.slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const relatedSpaces = Array.from(new Set([
  ...posts.flatMap(post => post.data.spaces ?? []),
  ...projects.flatMap(project => project.data.spaces ?? []),
]))
  .filter(slug => slug !== space.slug)
  .map(getSpace)
  .filter(Boolean)
  .slice(0, 5);
---

<PageLayout title={space.name} description={space.description}>
  <Container>
    <div class="space-y-10">
      <div class="animate">
        <BackToPrev href="/spaces">Back to spaces</BackToPrev>
      </div>

      <section class="animate">
        <div class="nb-on-color flex items-start gap-5 rounded-nb border-4 border-nb-border bg-nb-purple p-6 shadow-nb-xl sm:p-8">
          <span class="flex size-16 shrink-0 -rotate-3 items-center justify-center rounded-nb border-[3px] border-nb-border bg-nb-yellow shadow-nb-sm" aria-hidden="true">
            <img src={space.logo} alt="" class="size-8 object-contain" loading="lazy" decoding="async" />
          </span>
          <div class="space-y-2">
            <span class="nb-tag">Space</span>
            <h1 class="text-4xl font-black uppercase tracking-tight sm:text-5xl">{space.name}</h1>
            <p class="max-w-2xl text-lg font-semibold leading-7">{space.description}</p>
          </div>
        </div>
      </section>

      {projects.length > 0 && (
        <section class="animate space-y-5">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="nb-h2 orange">Projects</h2>
            <a href="/projects" class="nb-chip nb-press text-xs uppercase hover:bg-nb-orange">All projects →</a>
          </div>
          <ul class="nb-cycle flex flex-col gap-4">
            {projects.map(project => (
              <li><ArrowCard entry={project} /></li>
            ))}
          </ul>
        </section>
      )}

      {posts.length > 0 && (
        <section class="animate space-y-5">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="nb-h2">Posts</h2>
            <a href="/blog" class="nb-chip nb-press text-xs uppercase hover:bg-nb-pink">All posts →</a>
          </div>
          <ul class="nb-cycle flex flex-col gap-4">
            {posts.map(post => (
              <li><ArrowCard entry={post} /></li>
            ))}
          </ul>
        </section>
      )}

      {relatedSpaces.length > 0 && (
        <section class="animate space-y-5 border-t-[3px] border-dashed border-nb-border pt-8 dark:border-nb-border-dark">
          <h2 class="nb-h2 purple">Related spaces</h2>
          <ul class="flex flex-wrap gap-2">
            {relatedSpaces.map(related => related && (
              <li>
                <a href={`/spaces/${related.slug}`} class="nb-chip nb-press text-xs uppercase hover:bg-nb-purple"># {related.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </Container>
</PageLayout>
