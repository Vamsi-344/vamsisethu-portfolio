---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { SPACES, getSpace } from "@lib/spaces";

export function getStaticPaths() {
  return SPACES.map(space => ({
    params: { slug: space.slug },
    props: { space },
  }));
}

const { space } = Astro.props;

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft && post.data.spaces?.includes(space.slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft && project.data.spaces?.includes(space.slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const relatedSpaces = Array.from(new Set([
  ...posts.flatMap(post => post.data.spaces ?? []),
  ...projects.flatMap(project => project.data.spaces ?? []),
]))
  .filter(slug => slug !== space.slug)
  .map(getSpace)
  .filter(Boolean)
  .slice(0, 5);
---

<PageLayout title={space.name} description={space.description}>
  <Container>
    <div class="space-y-10">
      <div class="animate">
        <BackToPrev href="/spaces">Back to spaces</BackToPrev>
      </div>

      <section class="animate">
        <div class="flex items-start gap-4 rounded-xl border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-white/[0.03]">
          <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-[#1D88B5]/10 ring-1 ring-[#1D88B5]/10 dark:bg-[#1D88B5]/15 dark:ring-[#1D88B5]/20" aria-hidden="true">
            <img src={space.logo} alt="" class="size-8 object-contain" loading="lazy" decoding="async" />
          </span>
          <div class="space-y-2">
            <div class="text-sm text-black/55 dark:text-white/55">Space</div>
            <h1 class="text-3xl font-semibold tracking-tight text-black dark:text-white sm:text-4xl">{space.name}</h1>
            <p class="max-w-2xl text-base leading-7 text-black/55 dark:text-white/60">{space.description}</p>
          </div>
        </div>
      </section>

      {projects.length > 0 && (
        <section class="animate space-y-5">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="font-semibold text-black dark:text-white">Projects</h2>
            <Link href="/projects">All projects</Link>
          </div>
          <ul class="flex flex-col gap-3">
            {projects.map(project => (
              <li><ArrowCard entry={project} /></li>
            ))}
          </ul>
        </section>
      )}

      {posts.length > 0 && (
        <section class="animate space-y-5">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="font-semibold text-black dark:text-white">Posts</h2>
            <Link href="/blog">All posts</Link>
          </div>
          <ul class="flex flex-col gap-3">
            {posts.map(post => (
              <li><ArrowCard entry={post} /></li>
            ))}
          </ul>
        </section>
      )}

      {relatedSpaces.length > 0 && (
        <section class="animate space-y-4 border-t border-black/10 pt-8 dark:border-white/10">
          <h2 class="font-semibold text-black dark:text-white">Related spaces</h2>
          <ul class="flex flex-wrap gap-2">
            {relatedSpaces.map(related => related && (
              <li>
                <Link href={`/spaces/${related.slug}`}>{related.name}</Link>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </Container>
</PageLayout>
