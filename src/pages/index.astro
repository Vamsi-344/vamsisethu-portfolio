---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const siteURL = Astro.site?.toString() ?? "https://www.vamsisethu.com/";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  url: siteURL,
  email: `mailto:${SITE.EMAIL}`,
  jobTitle: "Site Reliability Engineer",
  description: HOME.DESCRIPTION,
  sameAs: SOCIALS
    .filter(s => s.HREF.startsWith("http"))
    .map(s => s.HREF),
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    name: "CNCF Kubestronaut",
    credentialCategory: "certification",
    recognizedBy: {
      "@type": "Organization",
      name: "Cloud Native Computing Foundation",
      url: "https://www.cncf.io/",
    },
    url: "https://www.credly.com/badges/7d557f73-f029-4d2c-9aef-f8a47a3b97fc/public_url",
  },
  knowsAbout: [
    "Kubernetes",
    "Site Reliability Engineering",
    "DevOps",
    "Cloud Infrastructure",
    "GitOps",
    "Observability",
    "Platform Engineering",
    "Bare-metal Provisioning",
    "AI Infrastructure",
  ],
};

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} structuredData={personSchema}>
  <Container>
    <div class="space-y-16">
      <section class="animate space-y-6">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-700 dark:text-orange-300">
          Platform engineering · SRE · AI infrastructure
        </p>
        <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-black dark:text-white sm:text-5xl">
          I build reliable platforms for difficult workloads.
        </h1>
        <article class="max-w-3xl space-y-4">
          <p>
            I'm Vamsi Krishna Sethu, a Software Engineer and <Link href="https://www.credly.com/badges/7d557f73-f029-4d2c-9aef-f8a47a3b97fc/public_url" external aria-label="Verify Kubestronaut credential on Credly">CNCF Kubestronaut</Link> working across the stack — from bare metal and private cloud to Kubernetes, AWS, and GitOps.
          </p>
          <p>
            I design the automation, identity, observability, and recovery paths that make infrastructure repeatable in production. Right now, I build multi-cluster platforms with Rancher and Argo CD Agent for inference-as-a-service.
          </p>
        </article>
        <div class="flex flex-wrap gap-3 pt-2">
          <Link href="/projects" class="rounded-md bg-black px-4 py-2 text-sm text-white no-underline transition hover:bg-black/80 dark:bg-white dark:text-black dark:hover:bg-white/80">
            Explore my work
          </Link>
          <Link href="/Vamsi_Krishna_Sethu_Resume.pdf" class="rounded-md border border-black/15 px-4 py-2 text-sm no-underline transition hover:border-black/40 dark:border-white/20 dark:hover:border-white/50">
            View resume
          </Link>
        </div>
      </section>

      <section class="grid gap-4 sm:grid-cols-3" aria-label="Areas of focus">
        <div class="rounded-lg border border-black/10 p-5 dark:border-white/10">
          <p class="mb-2 text-sm font-semibold text-black dark:text-white">Platform reliability</p>
          <p class="text-sm">Kubernetes, Rancher, RKE2, OpenShift, OpenStack, and production operations.</p>
        </div>
        <div class="rounded-lg border border-black/10 p-5 dark:border-white/10">
          <p class="mb-2 text-sm font-semibold text-black dark:text-white">Infrastructure automation</p>
          <p class="text-sm">Terraform, Ansible, GitOps, CI/CD, bare-metal provisioning, and repeatable delivery.</p>
        </div>
        <div class="rounded-lg border border-black/10 p-5 dark:border-white/10">
          <p class="mb-2 text-sm font-semibold text-black dark:text-white">Secure systems</p>
          <p class="text-sm">Identity, PKI, secrets delivery, observability, storage, and disaster recovery.</p>
        </div>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work Experience
          </h5>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            Reach out if you want to talk about Kubernetes platforms, DevOps, SRE,
            infrastructure automation, or cloud-native systems.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
