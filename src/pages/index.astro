---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const siteURL = Astro.site?.toString() ?? "https://www.vamsisethu.com/";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  url: siteURL,
  email: `mailto:${SITE.EMAIL}`,
  jobTitle: "Site Reliability Engineer",
  description: HOME.DESCRIPTION,
  sameAs: SOCIALS
    .filter(s => s.HREF.startsWith("http"))
    .map(s => s.HREF),
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    name: "CNCF Kubestronaut",
    credentialCategory: "certification",
    recognizedBy: {
      "@type": "Organization",
      name: "Cloud Native Computing Foundation",
      url: "https://www.cncf.io/",
    },
    url: "https://www.credly.com/badges/7d557f73-f029-4d2c-9aef-f8a47a3b97fc/public_url",
  },
  knowsAbout: [
    "Kubernetes",
    "Site Reliability Engineering",
    "DevOps",
    "Cloud Infrastructure",
    "GitOps",
    "Observability",
    "Platform Engineering",
    "Bare-metal Provisioning",
    "AI Infrastructure",
  ],
};

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} structuredData={personSchema}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Vamsi Krishna Sethu
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I am a Software Engineer and <Link href="https://www.credly.com/badges/7d557f73-f029-4d2c-9aef-f8a47a3b97fc/public_url" external aria-label="Verify Kubestronaut credential on Credly">CNCF Kubestronaut</Link>
            focused on DevOps and Site Reliability Engineering. I work across the
            stack — from bare metal to Kubernetes — building production-grade
            platforms, GitOps workflows, CI/CD automation, cloud-native storage,
            observability, and provisioning for AI infrastructure.
          </p>
          <p class="animate">
            Right now I'm building multi-cluster Kubernetes platforms with Rancher
            and ArgoCD Agent, and standing up AWS for inference-as-a-service. My
            recent work spans bare-metal Kubernetes (RKE2, Kubespray), MAAS-driven
            provisioning, and secure access with Teleport, alongside OpenShift,
            OpenStack, KubeVirt, Rook Ceph, Tekton, Prometheus, Grafana, Ansible,
            Terraform, Python, Bash, and Golang.
          </p>
          <p class="animate">
            I use this site to share selected projects, engineering notes, and practical
            writeups from building infrastructure platforms.
            <Link href="/Vamsi_Krishna_Sethu_Resume.pdf" aria-label="Resume">
              View resume
            </Link>
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work Experience
          </h5>
          <Link href="/work">
            See all work
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            Reach out if you want to talk about Kubernetes platforms, DevOps, SRE,
            infrastructure automation, or cloud-native systems.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
