---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { dateRange } from "@lib/utils";
import { SPACES as spaces, iconify } from "@lib/spaces";
import { SITE, HOME, SOCIALS, CERTS } from "@consts";

const allBlog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const blog = allBlog.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const allProjects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = allProjects.slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const techRows = [
  [
    { name: "Kubernetes", logo: iconify("simple-icons:kubernetes") },
    { name: "Rancher", logo: iconify("simple-icons:rancher") },
    { name: "RKE2", logo: iconify("simple-icons:rancher") },
    { name: "OpenShift", logo: iconify("simple-icons:redhatopenshift") },
    { name: "Docker", logo: iconify("simple-icons:docker") },
    { name: "Linux", logo: iconify("simple-icons:linux") },
  ],
  [
    { name: "Terraform", logo: iconify("simple-icons:terraform") },
    { name: "Ansible", logo: iconify("simple-icons:ansible") },
    { name: "Argo CD", logo: iconify("simple-icons:argo") },
    { name: "GitHub Actions", logo: iconify("simple-icons:githubactions") },
    { name: "Helm", logo: iconify("simple-icons:helm") },
    { name: "Tekton", logo: iconify("simple-icons:tekton") },
  ],
  [
    { name: "OpenStack", logo: iconify("simple-icons:openstack") },
    { name: "AWS", logo: iconify("simple-icons:amazonwebservices") },
    { name: "Prometheus", logo: iconify("simple-icons:prometheus") },
    { name: "Grafana", logo: iconify("simple-icons:grafana") },
    { name: "Ceph", logo: iconify("simple-icons:ceph") },
    { name: "PostgreSQL", logo: iconify("simple-icons:postgresql") },
  ],
];

type GitHubContributionDay = {
  contributionCount: number;
  date: string;
};

type GitHubContributionWeek = {
  contributionDays: GitHubContributionDay[];
};

const githubUsername = "Vamsi-344";

async function getGitHubActivity(): Promise<{ weeks: GitHubContributionWeek[]; totalContributions: number | null }> {
  const fallback = {
    weeks: [] as GitHubContributionWeek[],
    totalContributions: null as number | null,
  };

  try {
    const response = await fetch(`https://github.com/users/${githubUsername}/contributions`);

    if (!response.ok) return fallback;

    const html = await response.text();
    const totalContributions = Number(html.match(/<h2[^>]*>\s*([\d,]+)\s+contributions/i)?.[1]?.replace(/,/g, "")) || null;
    const days = new Map<string, GitHubContributionDay>();
    const dayPattern = /<td[^>]*data-date="([^"]+)"[^>]*id="([^"]+)"[^>]*>[\s\S]*?<\/td>\s*<tool-tip[^>]*for="\2"[^>]*>([\s\S]*?)<\/tool-tip>/g;

    for (const match of html.matchAll(dayPattern)) {
      const [, date, , label] = match;
      const contributionCount = Number(label.match(/(\d+)\s+contribution/i)?.[1] ?? 0);
      days.set(date, { date, contributionCount });
    }

    const sortedDays = [...days.values()].sort((a, b) => a.date.localeCompare(b.date));
    const weeks = Array.from({ length: Math.ceil(sortedDays.length / 7) }, (_, index) => ({
      contributionDays: sortedDays.slice(index * 7, index * 7 + 7),
    }));

    return {
      weeks,
      totalContributions,
    };
  } catch {
    return fallback;
  }
}

const githubActivity = await getGitHubActivity();
const githubWeeks = githubActivity.weeks;
const getContributionLevel = (count: number) => count === 0 ? 0 : count < 2 ? 1 : count < 5 ? 2 : count < 10 ? 3 : 4;

const siteURL = Astro.site?.toString() ?? "https://www.vamsisethu.com/";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  url: siteURL,
  email: `mailto:${SITE.EMAIL}`,
  jobTitle: "Site Reliability Engineer",
  description: HOME.DESCRIPTION,
  sameAs: SOCIALS
    .filter(s => s.HREF.startsWith("http"))
    .map(s => s.HREF),
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    name: "CNCF Kubestronaut",
    credentialCategory: "certification",
    recognizedBy: {
      "@type": "Organization",
      name: "Cloud Native Computing Foundation",
      url: "https://www.cncf.io/",
    },
    url: "https://www.credly.com/badges/7d557f73-f029-4d2c-9aef-f8a47a3b97fc/public_url",
  },
  knowsAbout: [
    "Kubernetes",
    "Site Reliability Engineering",
    "DevOps",
    "Cloud Infrastructure",
    "GitOps",
    "Observability",
    "Platform Engineering",
    "Bare-metal Provisioning",
    "AI Infrastructure",
  ],
};

const stats = [
  { label: "Posts", value: allBlog.length, note: "long-form write-ups", color: "bg-nb-yellow", href: "/blog" },
  { label: "Projects", value: allProjects.length, note: "platforms shipped", color: "bg-nb-green", href: "/projects" },
  { label: "CNCF certs", value: `${CERTS.ITEMS.length}/5`, note: "Kubestronaut", color: "bg-nb-blue", href: "/certifications" },
  { label: "Contributions", value: githubActivity.totalContributions?.toLocaleString("en-US") ?? "—", note: "on GitHub, last year", color: "bg-nb-pink", href: `https://github.com/${githubUsername}` },
];

const focusAreas = [
  { title: "Platform foundations", body: "Multi-cluster Kubernetes platforms across AWS, bare metal, and non-AWS environments.", color: "bg-nb-green", tilt: "nb-tilt-l", tag: "01" },
  { title: "Autonomous GitOps", body: "Hub/spoke delivery with automated bootstrap and independently recoverable clusters.", color: "bg-nb-blue", tilt: "nb-tilt-r", tag: "02" },
  { title: "Identity & secure delivery", body: "Workload identity, Private CA trust, and encrypted secret delivery from KMS to ESO.", color: "bg-nb-orange", tilt: "nb-tilt-l", tag: "03" },
];

const chipColors = ["bg-nb-pink", "bg-nb-blue", "bg-nb-green", "bg-nb-orange", "bg-nb-purple", "bg-nb-yellow"];
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} structuredData={personSchema}>
  <Container>
    <div class="space-y-24 md:space-y-28">
      <!-- Hero -->
      <section class="animate relative overflow-hidden rounded-nb border-4 border-nb-border bg-nb-yellow p-7 text-nb-ink shadow-nb-xl sm:p-10 md:p-12">
        <!-- decorative floating shapes (behind content, clipped by overflow-hidden) -->
        <span aria-hidden="true" class="nb-float pointer-events-none absolute -bottom-10 -left-10 size-28 rounded-full border-4 border-nb-border bg-nb-pink opacity-50"></span>
        <span aria-hidden="true" class="nb-float-slow pointer-events-none absolute -right-8 bottom-10 size-16 rotate-12 rounded-nb border-4 border-nb-border bg-nb-blue opacity-50"></span>
        <div class="relative">
          <div class="flex flex-wrap gap-2">
            <span class="nb-tag">Software Engineer</span>
            <span class="nb-tag bg-nb-pink">SRE</span>
            <span class="nb-tag bg-nb-blue">CNCF Kubestronaut</span>
          </div>
          <p class="mt-7 flex items-center gap-2 font-mono text-sm font-bold uppercase tracking-widest">
            <span class="relative flex size-2.5">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-nb-green opacity-75"></span>
              <span class="relative inline-flex size-2.5 rounded-full border-2 border-nb-border bg-nb-green"></span>
            </span>
            Hi, I'm Vamsi 👋
          </p>
          <h1 class="mt-3 text-balance text-4xl font-black leading-[1.03] tracking-tight sm:text-5xl md:text-[3.7rem]">
            I build cloud-native platforms for <span class="hero-accent inline-block -rotate-1 rounded-nb border-[3px] border-nb-border bg-nb-pink px-2 shadow-nb-xs">AI workloads</span> across Kubernetes, GitOps &amp; secure delivery.
          </h1>
          <p class="mt-6 max-w-2xl text-lg font-semibold leading-8">
            I work across AWS, bare metal, and autonomous spoke clusters — designing cluster lifecycle, workload identity, encrypted secrets, and recovery paths for production systems.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/projects" class="nb-btn bg-nb-ink !text-nb-yellow">Explore projects →</a>
            <a href="/blog" class="nb-btn-pink">Read writing</a>
            <a href="/Vamsi_Krishna_Sethu_Resume.pdf" class="nb-btn-white">View resume</a>
          </div>
        </div>
        <a href="#h-connect" class="absolute right-4 top-4 z-10 hidden no-underline nb-press rotate-3 rounded-nb border-[3px] border-nb-border bg-white px-3 py-1 font-mono text-xs font-black uppercase shadow-nb-sm sm:block">
          ★ say hi
        </a>
      </section>

      <!-- Stats -->
      <section class="animate grid grid-cols-2 gap-4 md:grid-cols-4" aria-label="At a glance">
        {stats.map(stat => (
          <a href={stat.href} class={`nb-card-interactive nb-on-color ${stat.color} p-4 text-center no-underline`}>
            <span class="block text-xs font-black uppercase tracking-wider">{stat.label}</span>
            <span class="my-1 block text-4xl font-black leading-none">{stat.value}</span>
            <span class="block text-xs font-semibold">{stat.note}</span>
          </a>
        ))}
      </section>

      <!-- Focus -->
      <section class="animate space-y-6" aria-labelledby="h-focus">
        <div>
          <h2 id="h-focus" class="nb-h2">What I work on</h2>
          <p class="mt-4 max-w-2xl font-medium nb-muted">The platform work I keep coming back to: clusters, delivery, and trust paths that stay understandable in production.</p>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {focusAreas.map(area => (
            <div class={`nb-card nb-on-color ${area.color} ${area.tilt} p-5`}>
              <span class="font-mono text-xs font-black">{area.tag}</span>
              <h3 class="mt-1 text-lg font-black uppercase leading-tight tracking-tight">{area.title}</h3>
              <p class="mt-2 text-sm font-medium leading-6">{area.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Work -->
      <section class="animate space-y-6" aria-labelledby="h-work">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 id="h-work" class="nb-h2 blue">Work experience</h2>
          <a href="/work" class="nb-chip nb-press text-xs uppercase hover:bg-nb-blue">See all work →</a>
        </div>
        <ol class="relative space-y-6 border-l-4 border-dashed border-nb-border pl-7 dark:border-nb-border-dark">
          {work.map(entry => {
            const isCurrent = entry.data.dateEnd === "Current";
            return (
            <li class={`nb-card relative p-5 ${isCurrent ? "border-l-[12px] !border-l-nb-green" : ""}`}>
              <span class={`absolute -left-[2.6rem] top-6 size-5 rounded-full border-[3px] border-nb-border ${isCurrent ? "bg-nb-green" : "bg-nb-blue"}`} aria-hidden="true"></span>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded border-2 border-nb-border bg-nb-yellow px-2 font-mono text-xs font-black uppercase text-nb-ink">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </span>
                {isCurrent && <span class="nb-tag bg-nb-green !py-0">Now</span>}
              </div>
              <div class="mt-2 text-lg font-black text-nb-ink dark:text-nb-ink-dark">
                {entry.data.company}
              </div>
              <div class="text-sm font-bold nb-muted">
                {entry.data.role}
              </div>
              <article class="mt-3">
                <entry.Content />
              </article>
            </li>
            );
          })}
        </ol>
      </section>

      <!-- GitHub -->
      <section class="animate space-y-6" aria-labelledby="h-activity">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 id="h-activity" class="nb-h2 green">Engineering activity</h2>
            <p class="mt-4 text-sm font-medium nb-muted">A public signal of ongoing work, experiments, and maintenance.</p>
          </div>
          <a href={`https://github.com/${githubUsername}`} target="_blank" rel="noopener noreferrer" class="nb-chip nb-press text-xs uppercase hover:bg-nb-green">View GitHub ↗</a>
        </div>
        <div class="nb-card p-5">
          {githubWeeks.length > 0 ? (
            <>
              <div class="-mx-5 overflow-x-auto px-5 pb-1 sm:mx-0 sm:px-0">
                <div class="grid w-max grid-flow-col grid-rows-7 gap-1" aria-label="GitHub contribution calendar">
                  {githubWeeks.map((week) => (
                    week.contributionDays.map((day) => {
                      const level = getContributionLevel(day.contributionCount);
                      return (
                        <a
                          href={`https://github.com/${githubUsername}?tab=overview&from=${day.date}&to=${day.date}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`${day.contributionCount} contribution${day.contributionCount === 1 ? "" : "s"} on ${day.date}`}
                          class:list={[
                            "size-2.5 rounded-[2px] border-2 border-nb-border no-underline transition-transform duration-150 hover:z-10 hover:scale-125 dark:border-nb-border-dark/60 sm:size-3",
                            level === 0 && "bg-white dark:bg-nb-bg-dark",
                            level === 1 && "bg-nb-green",
                            level === 2 && "bg-nb-blue",
                            level === 3 && "bg-nb-yellow",
                            level === 4 && "bg-nb-pink",
                          ]}
                        >
                          <span class="sr-only">{day.contributionCount} contributions on {day.date}</span>
                        </a>
                      );
                    })
                  ))}
                </div>
              </div>
              <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs font-bold nb-muted">
                <span>{githubActivity.totalContributions} contributions in the last year</span>
                <div class="flex items-center gap-1.5">
                  <span>Less</span>
                  {[0, 1, 2, 3, 4].map((level) => (
                    <span
                      class:list={[
                        "size-2.5 rounded-[2px] border-2 border-nb-border dark:border-nb-border-dark/60 sm:size-3",
                        level === 0 && "bg-white dark:bg-nb-bg-dark",
                        level === 1 && "bg-nb-green",
                        level === 2 && "bg-nb-blue",
                        level === 3 && "bg-nb-yellow",
                        level === 4 && "bg-nb-pink",
                      ]}
                    />
                  ))}
                  <span>More</span>
                </div>
              </div>
            </>
          ) : (
            <div class="text-sm font-medium nb-muted">
              GitHub contribution data is temporarily unavailable; the site still builds without it.
            </div>
          )}
        </div>
      </section>

      <!-- Posts -->
      <section class="animate space-y-6" aria-labelledby="h-posts">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 id="h-posts" class="nb-h2">Latest posts</h2>
          <a href="/blog" class="nb-chip nb-press text-xs uppercase hover:bg-nb-pink">See all posts →</a>
        </div>
        <ul class="nb-cycle flex flex-col gap-4">
          {blog.map(post => (
            <li><ArrowCard entry={post} /></li>
          ))}
        </ul>
      </section>

      <!-- Projects -->
      <section class="animate space-y-6" aria-labelledby="h-projects">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 id="h-projects" class="nb-h2 orange">Recent projects</h2>
          <a href="/projects" class="nb-chip nb-press text-xs uppercase hover:bg-nb-orange">See all projects →</a>
        </div>
        <ul class="nb-cycle flex flex-col gap-4">
          {projects.map(project => (
            <li><ArrowCard entry={project} /></li>
          ))}
        </ul>
      </section>

      <!-- Spaces -->
      <section class="animate space-y-6" aria-labelledby="h-spaces">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 id="h-spaces" class="nb-h2 purple">Spaces</h2>
            <p class="mt-4 text-sm font-medium nb-muted">Browse the work by the technical areas it belongs to.</p>
          </div>
          <a href="/spaces" class="nb-chip nb-press text-xs uppercase hover:bg-nb-purple">See all spaces →</a>
        </div>
        <ul class="nb-cycle grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {spaces.map(space => (
            <li>
              <a href={`/spaces/${space.slug}`} class="nb-card-interactive group flex items-center gap-3 px-4 py-3 no-underline">
                <span class="nb-accent nb-accent-bg flex size-10 items-center justify-center rounded-nb border-[3px] border-nb-border p-1.5 transition-transform group-hover:-rotate-6" aria-hidden="true">
                  <img src={space.logo} alt="" class="size-full object-contain" loading="lazy" decoding="async" />
                </span>
                <span class="font-black uppercase tracking-tight text-nb-ink dark:text-nb-ink-dark">{space.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Skills -->
      <section class="animate space-y-6 overflow-hidden" aria-labelledby="h-skills">
        <div>
          <h2 id="h-skills" class="nb-h2 yellow">Skills &amp; technologies</h2>
          <p class="mt-4 text-sm font-medium nb-muted">Tools I use to build, operate, and debug infrastructure.</p>
        </div>
        <div class="-mx-5 space-y-3 px-5 sm:mx-0 sm:px-0">
          {techRows.map((row, index) => (
            <div class="tech-marquee overflow-hidden py-1.5" data-direction={index % 2 === 0 ? "normal" : "reverse"}>
              <div class="tech-marquee-track flex w-max gap-3 pr-3">
                {[...row, ...row, ...row].map((technology, i) => (
                  <div class="flex items-center gap-2.5 rounded-nb border-[3px] border-nb-border bg-white px-3 py-1.5 text-sm shadow-nb-xs dark:border-nb-border-dark dark:bg-nb-card-dark">
                    <span class={`flex size-7 items-center justify-center rounded border-2 border-nb-border p-1 ${chipColors[(i + index) % chipColors.length]}`}>
                      <img src={technology.logo} alt="" class="size-full object-contain" loading="lazy" decoding="async" />
                    </span>
                    <span class="font-extrabold text-nb-ink dark:text-nb-ink-dark">{technology.name}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Connect -->
      <section class="animate nb-on-color rounded-nb border-4 border-nb-border bg-nb-pink p-6 shadow-nb-xl sm:p-8" aria-labelledby="h-connect">
        <h2 id="h-connect" class="text-3xl font-black uppercase tracking-tight">Let's connect</h2>
        <p class="mt-2 max-w-xl font-semibold">
          Reach out if you want to compare notes on Kubernetes platforms, SRE,
          infrastructure automation, or cloud-native operations.
        </p>
        <ul class="mt-5 flex flex-wrap gap-3">
          {SOCIALS.map((SOCIAL, i) => (
            <li>
              <a
                href={SOCIAL.HREF}
                target={SOCIAL.HREF.startsWith("http") ? "_blank" : undefined}
                rel={SOCIAL.HREF.startsWith("http") ? "noopener noreferrer" : undefined}
                aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
                class={`nb-chip nb-press text-sm uppercase ${["bg-white", "bg-nb-yellow", "bg-nb-blue", "bg-nb-green", "bg-nb-purple"][i % 5]}`}
              >
                {SOCIAL.NAME}
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`} class="nb-chip nb-press bg-nb-ink text-sm !text-nb-yellow">
              ✉ {SITE.EMAIL}
            </a>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>

<style>
  .tech-marquee {
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .tech-marquee-track {
    animation: tech-marquee 38s linear infinite;
  }

  .tech-marquee[data-direction="reverse"] .tech-marquee-track {
    animation-direction: reverse;
  }

  .tech-marquee:hover .tech-marquee-track {
    animation-play-state: paused;
  }

  @keyframes tech-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }

  /* Hero ambient floats */
  .nb-float { animation: nb-float 7s ease-in-out infinite; }
  .nb-float-slow { animation: nb-float 11s ease-in-out infinite; }

  @keyframes nb-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(6deg); }
  }

  /* Hero accent: gentle wobble on hover only */
  .hero-accent {
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
  }
  .hero-accent:hover {
    transform: rotate(1deg) translateY(-2px) scale(1.02);
    box-shadow: 4px 4px 0 0 var(--nb-shadow);
  }
</style>
