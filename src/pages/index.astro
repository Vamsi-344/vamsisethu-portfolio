---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SPACES as spaces, iconify } from "@lib/spaces";
import { SITE, HOME, SOCIALS } from "@consts";

const allBlog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const blog = allBlog.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const allProjects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = allProjects.slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const techRows = [
  [
    { name: "Kubernetes", logo: iconify("simple-icons:kubernetes") },
    { name: "Rancher", logo: iconify("simple-icons:rancher") },
    { name: "RKE2", logo: iconify("simple-icons:rancher") },
    { name: "OpenShift", logo: iconify("simple-icons:redhatopenshift") },
    { name: "Docker", logo: iconify("simple-icons:docker") },
    { name: "Linux", logo: iconify("simple-icons:linux") },
  ],
  [
    { name: "Terraform", logo: iconify("simple-icons:terraform") },
    { name: "Ansible", logo: iconify("simple-icons:ansible") },
    { name: "Argo CD", logo: iconify("simple-icons:argo") },
    { name: "GitHub Actions", logo: iconify("simple-icons:githubactions") },
    { name: "Helm", logo: iconify("simple-icons:helm") },
    { name: "Tekton", logo: iconify("simple-icons:tekton") },
  ],
  [
    { name: "OpenStack", logo: iconify("simple-icons:openstack") },
    { name: "AWS", logo: iconify("simple-icons:amazonwebservices") },
    { name: "Prometheus", logo: iconify("simple-icons:prometheus") },
    { name: "Grafana", logo: iconify("simple-icons:grafana") },
    { name: "Ceph", logo: iconify("simple-icons:ceph") },
    { name: "PostgreSQL", logo: iconify("simple-icons:postgresql") },
  ],
];

type GitHubContributionDay = {
  contributionCount: number;
  date: string;
};

type GitHubContributionWeek = {
  contributionDays: GitHubContributionDay[];
};

const githubUsername = "Vamsi-344";

async function getGitHubActivity(): Promise<{ weeks: GitHubContributionWeek[]; totalContributions: number | null }> {
  const fallback = {
    weeks: [] as GitHubContributionWeek[],
    totalContributions: null as number | null,
  };

  try {
    const response = await fetch(`https://github.com/users/${githubUsername}/contributions`);

    if (!response.ok) return fallback;

    const html = await response.text();
    const totalContributions = Number(html.match(/<h2[^>]*>\s*([\d,]+)\s+contributions/i)?.[1]?.replace(/,/g, "")) || null;
    const days = new Map<string, GitHubContributionDay>();
    const dayPattern = /<td[^>]*data-date="([^"]+)"[^>]*id="([^"]+)"[^>]*>[\s\S]*?<\/td>\s*<tool-tip[^>]*for="\2"[^>]*>([\s\S]*?)<\/tool-tip>/g;

    for (const match of html.matchAll(dayPattern)) {
      const [, date, , label] = match;
      const contributionCount = Number(label.match(/(\d+)\s+contribution/i)?.[1] ?? 0);
      days.set(date, { date, contributionCount });
    }

    const sortedDays = [...days.values()].sort((a, b) => a.date.localeCompare(b.date));
    const weeks = Array.from({ length: Math.ceil(sortedDays.length / 7) }, (_, index) => ({
      contributionDays: sortedDays.slice(index * 7, index * 7 + 7),
    }));

    return {
      weeks,
      totalContributions,
    };
  } catch {
    return fallback;
  }
}

const githubActivity = await getGitHubActivity();
const githubWeeks = githubActivity.weeks;
const getContributionLevel = (count: number) => count === 0 ? 0 : count < 2 ? 1 : count < 5 ? 2 : count < 10 ? 3 : 4;

const siteURL = Astro.site?.toString() ?? "https://www.vamsisethu.com/";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  url: siteURL,
  email: `mailto:${SITE.EMAIL}`,
  jobTitle: "Site Reliability Engineer",
  description: HOME.DESCRIPTION,
  sameAs: SOCIALS
    .filter(s => s.HREF.startsWith("http"))
    .map(s => s.HREF),
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    name: "CNCF Kubestronaut",
    credentialCategory: "certification",
    recognizedBy: {
      "@type": "Organization",
      name: "Cloud Native Computing Foundation",
      url: "https://www.cncf.io/",
    },
    url: "https://www.credly.com/badges/7d557f73-f029-4d2c-9aef-f8a47a3b97fc/public_url",
  },
  knowsAbout: [
    "Kubernetes",
    "Site Reliability Engineering",
    "DevOps",
    "Cloud Infrastructure",
    "GitOps",
    "Observability",
    "Platform Engineering",
    "Bare-metal Provisioning",
    "AI Infrastructure",
  ],
};
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} structuredData={personSchema}>
  <Container>
    <div class="space-y-16">
      <section class="animate space-y-6">
        <p class="text-sm text-black/55 dark:text-white/55">
          Hi, I'm Vamsi — Software Engineer · SRE · CNCF Kubestronaut
        </p>
        <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-black dark:text-white sm:text-5xl">
          I build cloud-native platforms for AI workloads across Kubernetes, GitOps, and secure delivery.
        </h1>
        <article class="max-w-2xl text-lg leading-8">
          <p>
            I work across AWS, bare metal, and autonomous spoke clusters — designing cluster lifecycle, workload identity, encrypted secrets, and recovery paths for production systems.
          </p>
        </article>
        <div class="flex flex-wrap gap-3 pt-1">
          <Link href="/projects" class="rounded-md bg-black px-4 py-2 text-sm text-white no-underline transition hover:bg-black/80 dark:bg-white dark:text-black dark:hover:bg-white/80">
            Explore projects
          </Link>
          <Link href="/blog" class="rounded-md border border-black/15 px-4 py-2 text-sm no-underline transition hover:border-black/40 dark:border-white/20 dark:hover:border-white/50">
            Read writing
          </Link>
          <Link href="/Vamsi_Krishna_Sethu_Resume.pdf" class="rounded-md border border-black/15 px-4 py-2 text-sm no-underline transition hover:border-black/40 dark:border-white/20 dark:hover:border-white/50">
            View resume
          </Link>
        </div>
      </section>

      <section class="animate overflow-hidden rounded-xl border border-black/10 bg-white dark:border-white/10 dark:bg-white/[0.03]" aria-label="Areas of focus">
        <div class="border-b border-black/10 bg-black/[0.025] px-5 py-4 dark:border-white/10 dark:bg-white/[0.04]">
          <h2 class="font-semibold text-black dark:text-white">What I work on</h2>
          <p class="mt-1 text-sm leading-6 text-black/55 dark:text-white/60">
            The platform work I keep coming back to: clusters, delivery, and trust paths that stay understandable in production.
          </p>
        </div>
        <div class="grid divide-y divide-black/10 dark:divide-white/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          <div class="p-5">
            <p class="mb-2 text-sm font-semibold text-black dark:text-white">Platform foundations</p>
            <p class="text-sm leading-6">Multi-cluster Kubernetes platforms across AWS, bare metal, and non-AWS environments.</p>
          </div>
          <div class="p-5">
            <p class="mb-2 text-sm font-semibold text-black dark:text-white">Autonomous GitOps</p>
            <p class="text-sm leading-6">Hub/spoke delivery with automated bootstrap and independently recoverable clusters.</p>
          </div>
          <div class="p-5">
            <p class="mb-2 text-sm font-semibold text-black dark:text-white">Identity & secure delivery</p>
            <p class="text-sm leading-6">Workload identity, Private CA trust, and encrypted secret delivery from KMS to ESO.</p>
          </div>
        </div>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 class="font-semibold text-black dark:text-white">Work Experience</h2>
          <Link href="/work">See all work</Link>
        </div>
        <ol class="relative space-y-8 border-l border-black/10 pl-6 dark:border-white/10">
          {work.map(entry => {
            const isCurrent = entry.data.dateEnd === "Current";
            return (
            <li class={`relative rounded-lg ${isCurrent ? "border border-[#1D88B5]/20 bg-[#1D88B5]/[0.04] p-4 -ml-4" : ""}`}>
              <span class={`absolute top-5 size-3 rounded-full border ${isCurrent ? "-left-[1.85rem] border-[#1D88B5] bg-[#1D88B5]" : "-left-[1.85rem] border-black/20 bg-[#f8f6f1] dark:border-white/20 dark:bg-[#10100f]"}`}></span>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="mt-1 font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article class="mt-3">
                <entry.Content />
              </article>
            </li>
            );
          })}
        </ol>
      </section>

      <section class="animate space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="font-semibold text-black dark:text-white">Engineering activity</h2>
            <p class="mt-1 text-sm text-black/50 dark:text-white/55">A public signal of ongoing work, experiments, and maintenance.</p>
          </div>
          <Link href={`https://github.com/${githubUsername}`} external>View GitHub</Link>
        </div>
        <div class="rounded-xl border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-white/[0.03]">
          {githubWeeks.length > 0 ? (
            <>
              <div class="overflow-x-auto pb-1">
                <div class="grid w-max grid-flow-col grid-rows-7 gap-1" aria-label="GitHub contribution calendar">
                  {githubWeeks.map((week) => (
                    week.contributionDays.map((day) => {
                      const level = getContributionLevel(day.contributionCount);

                      return (
                        <a
                          href={`https://github.com/${githubUsername}?tab=overview&from=${day.date}&to=${day.date}`}
                          target="_blank"
                          rel="noreferrer"
                          title={`${day.contributionCount} contribution${day.contributionCount === 1 ? "" : "s"} on ${day.date}`}
                          class:list={[
                            "size-3 rounded-[3px] border no-underline transition hover:ring-2 hover:ring-[#1D88B5]/30",
                            level === 0 && "border-black/5 bg-black/[0.035] dark:border-white/5 dark:bg-white/[0.04]",
                            level === 1 && "border-[#1D88B5]/10 bg-[#1D88B5]/20",
                            level === 2 && "border-[#1D88B5]/15 bg-[#1D88B5]/35",
                            level === 3 && "border-[#1D88B5]/20 bg-[#1D88B5]/55",
                            level === 4 && "border-[#1D88B5]/25 bg-[#1D88B5]/80",
                          ]}
                        >
                          <span class="sr-only">{day.contributionCount} contributions on {day.date}</span>
                        </a>
                      );
                    })
                  ))}
                </div>
              </div>

              <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-black/45 dark:text-white/45">
                <span>{githubActivity.totalContributions} contributions in the last year</span>
                <div class="flex items-center gap-1.5">
                  <span>Less</span>
                  {[0, 1, 2, 3, 4].map((level) => (
                    <span
                      class:list={[
                        "size-3 rounded-[3px] border",
                        level === 0 && "border-black/5 bg-black/[0.035] dark:border-white/5 dark:bg-white/[0.04]",
                        level === 1 && "border-[#1D88B5]/10 bg-[#1D88B5]/20",
                        level === 2 && "border-[#1D88B5]/15 bg-[#1D88B5]/35",
                        level === 3 && "border-[#1D88B5]/20 bg-[#1D88B5]/55",
                        level === 4 && "border-[#1D88B5]/25 bg-[#1D88B5]/80",
                      ]}
                    />
                  ))}
                  <span>More</span>
                </div>
              </div>
            </>
          ) : (
            <div class="text-sm text-black/55 dark:text-white/55">
              GitHub contribution data is temporarily unavailable; the site still builds without it.
            </div>
          )}
        </div>
      </section>

      <section class="animate space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 class="font-semibold text-black dark:text-white">Latest posts</h2>
          <Link href="/blog">See all posts</Link>
        </div>
        <ul class="flex flex-col gap-3">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 class="font-semibold text-black dark:text-white">Recent projects</h2>
          <Link href="/projects">See all projects</Link>
        </div>
        <ul class="flex flex-col gap-3">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-5">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="font-semibold text-black dark:text-white">Spaces</h2>
            <p class="mt-1 text-sm text-black/50 dark:text-white/55">Browse the work by the technical areas it belongs to.</p>
          </div>
          <Link href="/spaces">See all spaces</Link>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {spaces.map(space => (
            <li>
              <a href={`/spaces/${space.slug}`} class="flex items-center gap-3 rounded-lg border border-black/10 bg-white px-4 py-3 text-sm no-underline transition hover:border-black/25 hover:text-black dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-white/25 dark:hover:text-white">
                <span class="flex size-8 items-center justify-center rounded-full bg-[#1D88B5]/10 p-1.5 ring-1 ring-[#1D88B5]/10 dark:bg-[#1D88B5]/15 dark:ring-[#1D88B5]/20" aria-hidden="true">
                  <img src={space.logo} alt="" class="size-full object-contain" loading="lazy" decoding="async" />
                </span>
                <span class="font-medium text-black dark:text-white">{space.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-5 overflow-hidden">
        <div>
          <h2 class="font-semibold text-black dark:text-white">Skills & Technologies</h2>
          <p class="mt-1 text-sm text-black/50 dark:text-white/55">Tools I use to build, operate, and debug infrastructure.</p>
        </div>
        <div class="relative -mx-5 space-y-2 px-5 sm:mx-0 sm:px-0">
          <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-[#f8f6f1] to-transparent dark:from-[#10100f]"></div>
          <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-[#f8f6f1] to-transparent dark:from-[#10100f]"></div>
          {techRows.map((row, index) => (
            <div class="tech-marquee overflow-hidden py-1" data-direction={index % 2 === 0 ? "normal" : "reverse"}>
              <div class="tech-marquee-track flex w-max gap-3">
                {[...row, ...row, ...row].map(technology => (
                  <div class="flex items-center gap-3 rounded-full border border-black/10 bg-white px-3 py-2 text-sm shadow-sm dark:border-white/10 dark:bg-white/[0.03]">
                    <span class="flex size-8 items-center justify-center rounded-full bg-[#1D88B5]/10 p-1.5 ring-1 ring-[#1D88B5]/10 dark:bg-[#1D88B5]/15 dark:ring-[#1D88B5]/20">
                      <img src={technology.logo} alt="" class="size-full object-contain" loading="lazy" decoding="async" />
                    </span>
                    <span class="font-medium text-black dark:text-white">{technology.name}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="animate space-y-4 border-t border-black/10 pt-8 dark:border-white/10">
        <h2 class="font-semibold text-black dark:text-white">Let's Connect</h2>
        <article>
          <p>
            Reach out if you want to compare notes on Kubernetes platforms, SRE,
            infrastructure automation, or cloud-native operations.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external={SOCIAL.HREF.startsWith("http")} aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>

<style>
  .tech-marquee-track {
    animation: tech-marquee 38s linear infinite;
  }

  .tech-marquee[data-direction="reverse"] .tech-marquee-track {
    animation-direction: reverse;
  }

  .tech-marquee:hover .tech-marquee-track {
    animation-play-state: paused;
  }

  @keyframes tech-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-33.333%);
    }
  }
</style>
